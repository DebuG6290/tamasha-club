# Only for a separate frontend (Netlify) and Node server:
# Set this in Netlify BEFORE building, using the live Node server URL.
# VITE_API_BASE_URL=https://your-game-server.onrender.com
# Set this on the Node server, using your live Netlify URL.
# PUBLIC_ORIGINS=https://your-game.netlify.app

# When hosting the whole app on one Node service, leave both settings unset.
# PORT=4173
